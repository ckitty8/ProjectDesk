{
  "framework": null,
  "buildCommand": "npm --prefix web ci && npm --prefix web run build",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/",
      "destination": "/app/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/app/:chemin*",
      "destination": "/app/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
